{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2a20b6b1-5925-4f80-99b6-85480946207f","database_name": "nova-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8f47a0b164ac42a59140998ef395b8d2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
